### PKL Backend API v2 - Auth Slice HTTP Test Client
### Digunakan dengan REST Client extension di VS Code / Cursor / GoLand

@baseUrl = http://localhost:3000/api/v1

# Role IDs dari database lokal:
# Siswa: b94cec6f-805e-4474-a4d5-4b46ba9227e8
# Admin: fe106b1e-f013-4057-b20f-5d484c130159
# Guru: 334e5885-c240-40a0-ad61-10c31436eff1
# Pembimbing: 211bed60-6ac7-43cd-aa0a-4ea8382cb227
@defaultRoleId = b94cec6f-805e-4474-a4d5-4b46ba9227e8

# Akun uji coba
@testEmail = siswa_testing@smkn6malang.sch.id
@testPassword = Password123!


# ==============================================================================
# 1. HEALTH CHECK
# ==============================================================================
### Cek status server
GET http://localhost:3000/health


# ==============================================================================
# 2. REGISTER
# ==============================================================================
### Registrasi Akun Siswa Baru (Berhasil)
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Ahmad Siswa PKL",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}",
  "role_id": "{{defaultRoleId}}"
}

### Registrasi Gagal - Validasi Error (Field kosong / format salah)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "A",
  "email": "bukan-email",
  "password": "123",
  "role_id": "00000000-0000-0000-0000-000000000000"
}

### Registrasi Gagal - Email Duplikat (Conflict 409)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Ahmad Siswa PKL",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}",
  "role_id": "{{defaultRoleId}}"
}


# ==============================================================================
# 3. LOGIN
# ==============================================================================
### Login Berhasil (Menyimpan token otomatis untuk request berikutnya)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}",
  "remember": true
}

### Token yang didapat otomatis dari request login di atas
@authToken = {{login.response.body.data.access_token}}

### Login Gagal - Password Salah (Unauthorized 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "PasswordSalah123!"
}

### Login Gagal - Email Tidak Ditemukan
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "tidakada@smkn6malang.sch.id",
  "password": "Password123!"
}


# ==============================================================================
# 4. PROFILE (/me - PROTECTED)
# ==============================================================================
### Ambil Profil Pengguna Saat Ini (Wajib Header Authorization)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### Ambil Profil Gagal - Tanpa Token (Unauthorized 401)
GET {{baseUrl}}/auth/me


# ==============================================================================
# 5. REFRESH TOKEN
# ==============================================================================
### Perbarui Access Token (Menggunakan Cookie HTTPOnly yang disimpan otomatis)
POST {{baseUrl}}/auth/refresh


# ==============================================================================
# 6. GOOGLE OAUTH
# ==============================================================================
### Google Login - Ditolak jika belum di-bind (Aturan Bind-Only)
# Kirim dummy credential untuk melihat pesan penolakan bind-only
POST {{baseUrl}}/auth/google/login
Content-Type: application/json

{
  "credential": "dummy_google_credential_token_here"
}

### Google Bind - Menautkan Akun Google ke Profil (Protected)
# Masukkan Google ID Token asli dari frontend (Google OAuth Client)
POST {{baseUrl}}/auth/google/bind
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "credential": "MASUKKAN_GOOGLE_ID_TOKEN_DARI_FRONTEND_DI_SINI"
}

### Google Unbind - Melepas Tautan Akun Google (Protected)
DELETE {{baseUrl}}/auth/google/unbind
Authorization: Bearer {{authToken}}


# ==============================================================================
# 7. LOGOUT
# ==============================================================================
### Keluar dari Akun (Mencabut sesi dan menghapus cookie)
POST {{baseUrl}}/auth/logout


# ==============================================================================
# 8. MANAJEMEN DEPARTEMEN / JURUSAN
# ==============================================================================
### Ambil Semua Jurusan (Departments)
GET {{baseUrl}}/departments
Authorization: Bearer {{authToken}}

### Tambah Jurusan Baru
# @name createDepartment
POST {{baseUrl}}/departments
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Teknik Otomasi Industri",
  "code": "TOI",
  "color": "#F59E0B"
}

@newDeptId = {{createDepartment.response.body.data.id}}

### Ambil Detail Jurusan
GET {{baseUrl}}/departments/{{newDeptId}}
Authorization: Bearer {{authToken}}

### Ubah Data Jurusan
PUT {{baseUrl}}/departments/{{newDeptId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Teknik Otomasi & Mekatronika",
  "color": "#10B981"
}


# ==============================================================================
# 9. MANAJEMEN PERUSAHAAN MITRA / INDUSTRI
# ==============================================================================
### Ambil Semua Perusahaan Mitra
GET {{baseUrl}}/companies
Authorization: Bearer {{authToken}}

### Tambah Perusahaan Mitra Baru
# @name createCompany
POST {{baseUrl}}/companies
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "PT Telkom Digital Solusindo",
  "email": "hr@telkomdigital.co.id",
  "phone_number": "081234567890",
  "address": "Jl. Telkom Megah No. 45, Malang",
  "description": "Mitra industri resmi PKL bidang Software Engineering & Network.",
  "status": "active"
}

@newCompanyId = {{createCompany.response.body.data.id}}

### Ambil Detail Perusahaan
GET {{baseUrl}}/companies/{{newCompanyId}}
Authorization: Bearer {{authToken}}


# ==============================================================================
# 10. MANAJEMEN PENGGUNA (USERS & SUB-AKUN INDUSTRI)
# ==============================================================================
### Ambil Daftar Pengguna (Paginasi + Filter)
GET {{baseUrl}}/users?page=1&limit=10&search=&status=active
Authorization: Bearer {{authToken}}

### Tambah Akun Utama Industri (Industry Lead)
# @name createIndustryUser
POST {{baseUrl}}/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Budi Santoso (PIC Telkom)",
  "email": "budi.pic@telkomdigital.co.id",
  "password": "PasswordPIC2026!",
  "role_id": "c26d80e8-77f0-45f5-8690-3162efd2d773",
  "company_id": "{{newCompanyId}}",
  "status": "active"
}

@industryLeadId = {{createIndustryUser.response.body.data.id}}

### Tambah Sub-Akun Siswa PKL (Terhubung ke Jurusan & Industri & PIC Pembimbing)
# @name createStudentUser
POST {{baseUrl}}/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Rizky Siswa Telkom",
  "email": "rizky.pkl@smkn6malang.sch.id",
  "password": "PasswordSiswa2026!",
  "role_id": "{{defaultRoleId}}",
  "department_id": "{{newDeptId}}",
  "company_id": "{{newCompanyId}}",
  "parent_id": "{{industryLeadId}}",
  "status": "active"
}

@studentUserId = {{createStudentUser.response.body.data.id}}

### Ambil Detail Pengguna
GET {{baseUrl}}/users/{{studentUserId}}
Authorization: Bearer {{authToken}}

### Ubah Data Pengguna (Ganti Nama / Status)
PUT {{baseUrl}}/users/{{studentUserId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Rizky Pratama Siswa Telkom",
  "status": "active"
}

### Hapus Pengguna (Soft Delete)
DELETE {{baseUrl}}/users/{{studentUserId}}
Authorization: Bearer {{authToken}}
