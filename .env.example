# ==============================================================================
# PKL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Digunakan bersama oleh: pkl-db, pkl-storage, dan pkl-golang-be
# ==============================================================================

# --- Backend Application ---
PORT=3000
APP_ENV=development
AUTO_BOOTSTRAP=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database Engine (pkl-db) ---
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres

# --- Database Connection (pkl-golang-be) ---
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pkl_development
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# --- Storage Engine (pkl-storage) ---
STORAGE_PORT=54321
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800
TENANT_ID=stub
STORAGE_S3_REGION=local
GLOBAL_S3_BUCKET=stub
S3_PROTOCOL_ENABLED=true
S3_PROTOCOL_ACCESS_KEY_ID=your_storage_s3_access_key_min_32_chars
S3_PROTOCOL_ACCESS_KEY_SECRET=your_storage_s3_secret_key_min_32_chars
# S3_PROTOCOL_PREFIX=
PGRST_JWT_SECRET=your_pgrst_jwt_secret_minimum_32_chars
ENABLE_IMAGE_TRANSFORMATION=false

# --- Storage S3 Client (pkl-golang-be) ---
# S3_ACCESS_KEY & S3_SECRET_KEY harus sama persis dengan kredensial S3_PROTOCOL di atas
S3_ENDPOINT=http://127.0.0.1:54321/s3
S3_PUBLIC_ENDPOINT=http://127.0.0.1:54321/s3
S3_REGION=local
S3_BUCKET=pkl-assets
S3_ACCESS_KEY=your_storage_s3_access_key_min_32_chars
S3_SECRET_KEY=your_storage_s3_secret_key_min_32_chars
S3_PUBLIC_URL_PREFIX=http://127.0.0.1:54321/object/public/pkl-assets
S3_USE_PATH_STYLE=true

# --- Auth ---
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRY_HOURS=72
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- Default Admin Seeder ---
DEFAULT_ADMIN_NAME="Administrator"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="your_secure_password_here"
