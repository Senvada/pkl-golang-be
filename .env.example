PORT=3000
APP_ENV=development
AUTO_BOOTSTRAP=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (Supabase PostgreSQL Local)
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pkl_development
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# Storage (Supabase Storage S3 Local)
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_BUCKET=pkl-assets
S3_ACCESS_KEY=super_secret_key_pkl_development_minimum_32_chars
S3_SECRET_KEY=super_secret_key_pkl_development_minimum_32_chars
S3_PUBLIC_URL_PREFIX=http://127.0.0.1:54321/storage/v1/object/public/pkl-assets
S3_USE_PATH_STYLE=true

# Auth
JWT_SECRET=super_secret_jwt_key_pkl_development_minimum_32_chars
JWT_EXPIRY_HOURS=72
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Default Admin Seeder
DEFAULT_ADMIN_NAME="Name Here"
DEFAULT_ADMIN_EMAIL="email@here.id"
DEFAULT_ADMIN_PASSWORD="123345"
